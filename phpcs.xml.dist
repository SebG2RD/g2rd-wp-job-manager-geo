<?xml version="1.0"?>
<ruleset name="G2RD WP Job Manager Geo">
    <description>WordPress Coding Standards pour le plugin G2RD WP Job Manager Geo (PHP 7.4+).</description>

    <file>./g2rd-wpjm-geo/g2rd-wpjm-geo.php</file>
    <file>./g2rd-wpjm-geo/uninstall.php</file>
    <file>./g2rd-wpjm-geo/includes</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>

    <rule ref="WordPress-Core">
        <!-- Classes chargées par l'autoloader du plugin : fichiers nommés Settings.php, pas class-settings.php. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Alignement automatique désactivé : churn à chaque ajout de clé, sans valeur. -->
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
    </rule>

    <!-- Sécurité : échappement et sanitisation, bloquants. -->
    <rule ref="WordPress.Security"/>
    <!-- Plugin Check refuse strip_tags() : wp_strip_all_tags() à la place. -->
    <rule ref="WordPress.WP.AlternativeFunctions.strip_tags_strip_tags">
        <type>error</type>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_supported_wp_version" value="6.4"/>
    <config name="text_domain" value="g2rd-wpjm-geo"/>
</ruleset>
