# Fins de ligne normalisées.
* text=auto eol=lf
*.php text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.dist text eol=lf
*.woff2 binary
*.zip binary

# Exclus des archives « git archive » (le ZIP de release est construit par
# tools/build-zip.php dans release.yml).
/.github                   export-ignore
/docs                      export-ignore
/tools                     export-ignore
/g2rd-wpjm-geo/tests       export-ignore
/.gitattributes            export-ignore
/.gitignore                export-ignore
/composer.json             export-ignore
/composer.lock             export-ignore
/phpcs.xml.dist            export-ignore
/phpcs-security.xml        export-ignore
/phpstan.neon.dist         export-ignore
/README.md                 export-ignore
